# OpenAlex API Key (required for authenticated OpenAlex queries and higher credit limits)
# Register at: https://openalex.org/
OPENALEX_API_KEY=your_openalex_api_key_here

# OpenAlex Contact Email (optional fallback)
OPENALEX_MAILTO=your_email@example.com

# Gemini API Key (required for affiliation normalization via gemini-2.5-flash-lite)
GEMINI_API_KEY=your_gemini_api_key_here

# IEEE Xplore API Key (optional for IEEE extractor)
IEEE_API_KEY=your_ieee_api_key_here

# Elsevier Scopus API Key (optional for Scopus extractor)
SCOPUS_API_KEY=your_scopus_api_key_here
